   "source": [
    "# 3. Análisis de Antigüedad y Desarrollo de Carrera"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "**Objetivo:** Analizar la relación entre la antigüedad de los empleados en la empresa y su progresión salarial y de títulos para evaluar si la empresa recompensa la lealtad."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import psycopg2\n",
    "import getpass\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from datetime import datetime"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Conexión a la Base de Datos\n",
    "Por favor, introduce las credenciales de la base de datos a continuación."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "db_name = input(\"Database Name: \")\n",
    "db_user = input(\"Database User: \")\n",
    "db_pass = getpass.getpass(\"Database Password: \")\n",
    "db_host = \"postgres\"\n",
    "db_port = \"5432\"\n",
    "\n",
    "try:\n",
    "    conn = psycopg2.connect(\n",
    "        dbname=db_name,\n",
    "        user=db_user,\n",
    "        password=db_pass,\n",
    "        host=db_host,\n",
    "        port=db_port\n",
    "    )\n",
    "    print(\"Conexión a la base de datos exitosa.\")\n",
    "except psycopg2.OperationalError as e:\n",
    "    print(f\"Error en la conexión: {e}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### (Debug) Verificar datos de empleados activos"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "debug_query_salaries = \"SELECT COUNT(*) FROM salaries WHERE to_date = '9999-12-31';\"\n",
    "debug_query_titles = \"SELECT COUNT(*) FROM titles WHERE to_date = '9999-12-31';\"\n",
    "\n",
    "try:\n",
    "    salaries_count = pd.read_sql_query(debug_query_salaries, conn).iloc[0,0]\n",
    "    titles_count = pd.read_sql_query(debug_query_titles, conn).iloc[0,0]\n",
    "    print(f\"Registros en 'salaries' con to_date='9999-12-31': {salaries_count}\")\n",
    "    print(f\"Registros en 'titles' con to_date='9999-12-31': {titles_count}\")\n",
    "except Exception as e:\n",
    "    print(f\"Error durante la depuración: {e}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Consulta SQL principal para obtener los datos"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "query = \"\"\"\n",
    "SELECT \n",
    "    e.emp_no, \n",
    "    e.hire_date,\n",
    "    s.salary,\n",
    "    t.title\n",
    "FROM \n",
    "    employees e\n",
    "JOIN \n",
    "    salaries s ON e.emp_no = s.emp_no AND s.to_date = '9999-12-31'\n",
    "JOIN \n",
    "    titles t ON e.emp_no = t.emp_no AND t.to_date = '9999-12-31';\n",
    "\"\"\"\n",
    "\n",
    "try:\n",
    "    df = pd.read_sql_query(query, conn)\n",
    "    # Calcular antiguedad en años\n",
    "    current_date = datetime.now()\n",
    "    df['hire_date'] = pd.to_datetime(df['hire_date'])\n",
    "    df['seniority_years'] = (current_date - df['hire_date']).dt.days / 365.25\n",
    "    print(\"DataFrame principal:\")\n",
    "    display(df.head())\n",
    "except Exception as e:\n",
    "    print(f\"Error al ejecutar la consulta principal: {e}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Análisis de Salario vs. Antigüedad"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.style.use('seaborn-v0_8-whitegrid')\n",
    "if 'df' in locals() and not df.empty:\n",
    "    plt.figure(figsize=(12, 7))\n",
    "    sns.scatterplot(data=df, x='seniority_years', y='salary', alpha=0.5, color='darkcyan')\n",
    "    sns.regplot(data=df, x='seniority_years', y='salary', scatter=False, color='red', label='Línea de Tendencia')\n",
    "    plt.title('Relación entre Antigüedad y Salario', fontsize=16)\n",
    "    plt.xlabel('Antigüedad (Años)', fontsize=12)\n",
    "    plt.ylabel('Salario Actual', fontsize=12)\n",
    "    plt.legend()\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "else:\n",
    "    print(\"El DataFrame está vacío. No se puede generar el gráfico de salario vs. antigüedad.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Análisis de Título vs. Antigüedad"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if 'df' in locals() and not df.empty:\n",
    "    # Ordenar los títulos por la antigüedad media para una mejor visualización\n",
    "    title_order = df.groupby('title')['seniority_years'].mean().sort_values().index\n",
    "    \n",
    "    plt.figure(figsize=(14, 8))\n",
    "    sns.boxplot(data=df, x='title', y='seniority_years', order=title_order, palette='crest')\n",
    "    plt.title('Distribución de Antigüedad por Título', fontsize=16)\n",
    "    plt.xlabel('Título', fontsize=12)\n",
    "    plt.ylabel('Antigüedad (Años)', fontsize=12)\n",
    "    plt.xticks(rotation=45, ha='right')\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "else:\n",
    "    print(\"El DataFrame está vacío. No se puede generar el gráfico de título vs. antigüedad.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Progresión de Carrera: Antigüedad Media para Alcanzar Títulos"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if 'df' in locals() and not df.empty:\n",
    "    avg_seniority_by_title = df.groupby('title')['seniority_years'].mean().reset_index()\n",
    "    avg_seniority_by_title = avg_seniority_by_title.sort_values('seniority_years', ascending=False)\n",
    "    \n",
    "    plt.figure(figsize=(12, 7))\n",
    "    sns.barplot(data=avg_seniority_by_title, x='seniority_years', y='title', palette='viridis_r')\n",
    "    plt.title('Antigüedad Media para Alcanzar cada Título', fontsize=16)\n",
    "    plt.xlabel('Antigüedad Media (Años)', fontsize=12)\n",
    "    plt.ylabel('Título', fontsize=12)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "else:\n",
    "    print(\"El DataFrame está vacío. No se puede generar el gráfico de progresión de carrera.\")\n",
    "\n",
    "# Cerrar la conexión\n",
    "if 'conn' in locals() and conn is not None:\n",
    "    conn.close()\n",
    "    print(\"Conexión cerrada.\")"
   ]
  }
