-- 
-- -- Política para HR: ve todos los empleados activos
-- CREATE POLICY hr_view ON employees FOR SELECT TO hr_user_role 
--     USING (end_date = '9999-12-31');
-- 
-- -- Política para usuarios básicos: solo información pública
-- CREATE POLICY basic_view ON employees FOR SELECT TO basic_user_role 
--     USING (end_date = '9999-12-31');

-- 8. REVOCAR PERMISOS POR DEFECTO
REVOKE ALL ON ALL TABLES IN SCHEMA public FROM PUBLIC;
REVOKE ALL ON ALL SEQUENCES IN SCHEMA public FROM PUBLIC;

-- 9. FUNCIÓN PARA CAMBIAR ROLES (EJEMPLO)
CREATE OR REPLACE FUNCTION change_user_role(
    p_username VARCHAR,
    p_new_role VARCHAR
) RETURNS VOID AS $$
BEGIN
    EXECUTE format('REVOKE admin_role, hr_user_role, basic_user_role FROM %I', p_username);
    EXECUTE format('GRANT %I TO %I', p_new_role, p_username);
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- 10. AUDITORÍA DE ACCESOS (OPCIONAL)
CREATE TABLE access_audit (
    audit_id SERIAL PRIMARY KEY,
    username VARCHAR(50),
    role_name VARCHAR(50),
    action_taken VARCHAR(100),
    table_affected VARCHAR(50),
    access_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

GRANT INSERT ON access_audit TO admin_role, hr_user_role;